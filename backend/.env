# ============================================================
#  AgentCheck — copy this file to  backend/.env  and fill in.
#  The ONLY key you actually need for a fully-live demo:
#  TOKENROUTER_API_KEY  (powers resume analysis, company
#  discovery, and recruiter outreach). Live job scraping +
#  news signals use FREE public APIs and need no key.
# ============================================================

# --- PRIMARY LLM: TokenRouter (required for dynamic output) ---
TOKENROUTER_API_KEY=sk-p3Nv2w7LBbRwncI8wqQQK1Dl5RRIiX29kkiGlQpRJFKDGot4
TOKENROUTER_BASE_URL=https://api.tokenrouter.com/v1
# TokenRouter valid models: auto:balance, auto:fast, auto:quality, openai:gpt-4o
TOKENROUTER_MODEL=openai/gpt-4o-mini

# --- SECONDARY LLM: Qwen (optional fallback, leave blank if unused) ---
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus

# --- Live scraping (OPTIONAL): Bright Data Web Unlocker proxy.
#     Leave blank — Greenhouse/Lever/Google-News are free & public. ---
BRIGHTDATA_API_KEY=
BRIGHTDATA_ZONE=web_unlocker

# --- Optional sponsor integrations (graceful if blank) ---
AGENTFIELD_API_KEY=
ACTIONBOOK_API_KEY=
EVERMIND_API_KEY=

# --- Frontend origin (CORS is open by default; informational) ---
FRONTEND_ORIGIN=http://localhost:5173
